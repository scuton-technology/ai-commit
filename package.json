{
  "name": "@scuton/ai-commit",
  "version": "1.1.0",
  "description": "AI-powered git commit message generator. Conventional commits from your diff.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "aic": "dist/cli.js",
    "ai-commit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/cli.ts src/index.ts --format esm,cjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git", "commit", "ai", "conventional-commits", "openai", "anthropic",
    "claude", "gpt", "developer-tools", "cli", "automation", "dx"
  ],
  "author": "Scuton Technology <info@scuton.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scuton-technology/ai-commit.git"
  },
  "homepage": "https://github.com/scuton-technology/ai-commit",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@inquirer/select": "^4.0.0",
    "commander": "^12.0.0",
    "openai": "^4.70.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  }
}
